# Trading Bot Configuration

# Exchange Settings (CCXT)
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_SANDBOX=true

# Legacy Broker API Keys (for stock trading)
# Example: Alpaca, Interactive Brokers, etc.
BROKER_API_KEY=
BROKER_SECRET_KEY=
BROKER_BASE_URL=https://paper-api.alpaca.markets

# Trading Settings
INITIAL_CAPITAL=10000
MAX_POSITION_SIZE=0.1
RISK_PER_TRADE=0.02

# Data Settings
DATA_PROVIDER=ccxt
CACHE_DATA=true

# Backtesting Engine
BACKTEST_ENGINE=backtrader
# Options: 'backtrader' or 'custom'

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log

